{
  "name": "business-auto",
  "version": "0.1.0",
  "description": "Business process automation platform built with Node.js, Temporal, Redis and AWS CDK",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "worker": "node src/worker.js",
    "api": "node src/api/server.js",
    "start:hello": "node src/scripts/start-hello.js",
    "start:invoice": "node src/scripts/start-invoice.js",
    "invoice": "node src/scripts/invoice.js",
    "test": "jest",
    "test:unit": "jest test/activities test/api",
    "test:workflows": "jest test/workflows",
    "cdk:synth": "npm --prefix infra run synth",
    "cdk:diff": "npm --prefix infra run diff",
    "cdk:test": "npm --prefix infra test",
    "docker:build": "docker build -t business-auto ."
  },
  "dependencies": {
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.25.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/test/helpers/quiet-logs.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/infra/"
    ]
  }
}
